<view class="page">
  <view class="section">
    <view class="title">{{funnelName || '导入数据'}}</view>
    <view class="muted">从 Excel 复制「日期 + 各阶段」的单元格区域后粘贴到下面。第一行是表头，第一列是日期。</view>
  </view>

  <view class="card section" wx:if="{{loadError}}">
    <view class="muted">{{loadError}}</view>
  </view>

  <block wx:else>
    <view class="card section">
      <view class="field-label">目标漏斗的阶段顺序</view>
      <view class="muted">{{stageSummary}}</view>
      <view class="muted hint">表头的阶段名必须和上面完全对应，顺序可以不同——系统按名称匹配，不按位置。</view>
      <button class="ghost-button" bindtap="readClipboard">读取剪贴板</button>
    </view>

    <view class="card section">
      <view class="field-label">粘贴区</view>
      <textarea
        class="paste-area"
        value="{{text}}"
        placeholder="{{placeholderText}}"
        bindinput="onTextInput"
        bindblur="onTextBlur"
        maxlength="-1"
      />
      <view class="row-actions">
        <view class="small-button" bindtap="transpose">一键转置</view>
        <text class="muted">行列贴反了再按一次可转回</text>
      </view>
    </view>

    <!-- 解析失败（D9：一次列全所有问题位置，整批拒绝） -->
    <view class="card section error-card" wx:if="{{parsed && !parseOk}}">
      <view class="field-label error-title">发现 {{parseErrorCount}} 处问题，整批未导入</view>
      <view class="error-item" wx:for="{{parseErrors}}" wx:key="id">
        <text class="error-pos">{{item.positionText}}</text>
        <text class="error-text">{{item.message}}</text>
      </view>
      <view class="muted" wx:if="{{parseErrorCount > parseErrors.length}}">
        仅显示前 {{parseErrors.length}} 条，共 {{parseErrorCount}} 条问题。
      </view>
    </view>

    <!-- 服务端复核未通过 -->
    <view class="card section error-card" wx:if="{{importErrorCount}}">
      <view class="field-label error-title">云函数复核未通过（{{importErrorCount}} 处）</view>
      <view class="error-item" wx:for="{{importErrors}}" wx:key="id">
        <text class="error-text">{{item.message}}</text>
      </view>
    </view>

    <!-- 预览（D9：预览只是体验层，真正决定能否入库的是云函数） -->
    <view class="card section" wx:if="{{parsed && parseOk}}">
      <view class="field-label">预览：共 {{previewCount}} 天</view>
      <view class="muted hint">日期范围 {{dateRangeText}}（已按导入顺序对齐到上面的阶段顺序）</view>

      <scroll-view class="preview-scroll" scroll-x>
        <view class="preview-table">
          <view class="preview-row preview-head">
            <view class="cell cell-date">日期</view>
            <view class="cell" wx:for="{{stages}}" wx:key="*this">{{item}}</view>
          </view>
          <view class="preview-row" wx:for="{{previewRows}}" wx:key="date">
            <view class="cell cell-date">{{item.date}}</view>
            <view class="cell" wx:for="{{item.cells}}" wx:for-item="cell" wx:key="key">{{cell.text}}</view>
          </view>
        </view>
      </scroll-view>

      <button
        class="button import-button"
        bindtap="onImport"
        loading="{{importing}}"
        disabled="{{importing}}"
      >确认导入</button>
    </view>
  </block>
</view>
